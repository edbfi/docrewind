{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,json,jsonc,css,svelte,html}",
      "!!**/.output",
      "!**/.wxt",
      "!!**/coverage",
      "!!**/dist",
      "!!**/test-results",
      "!!**/playwright-report",
      "!!**/.omc",
      "!!**/.omx",
      "!!.agents/skills",
      "!!.claude",
      "!!.codex",
      "!!.impeccable",
      "!!.opencode",
      "!!skills-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "complexity": {
        "noForEach": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "preset": "recommended"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": [
        "components/replay/DocumentViewport.svelte",
        "components/replay/SummaryInsights.svelte"
      ],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["entrypoints/replay/ReplaySurface.svelte"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveTabindex": "off"
          }
        }
      }
    }
  ]
}
